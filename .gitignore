!Play-RenegadeSquadronPC.cmd
!Capture-Texture-Baseline.ps1
!Capture-Rendering-Diagnostics.ps1
!Capture-Converted-OrdMantell.ps1
!Capture-Converted-Map.ps1

!work/
work/*
!work/*.cmd
!work/*.ps1
!work/*.py
!work/test-texture-browser095.cjs
!work/*.txt
!work/*.json
!work/rendering/
!work/rendering/*.ini
!work/render092-dx12.ini

!work/project/
!work/project/**
# Menu/text tools for the PC settings pages (the generated modsiles stay private: game data).
!work/tools/
!work/tools/pcmods/
!work/tools/pcmods/*.py


# Explicitly keep copyrighted/large local-only material out of Git.
*.iso
*.7z
*.zip
*.png
*.exe
*.dll
*.lib
*.pdb
*.wav
*.mp4
*.pyc
__pycache__/

work/game/
work/windows-deps/
work/build-windows-native/
work/build-tools/
work/upscale-tools/
work/upscale106/
work/upscale107/
work/mods-upscale106/
work/mods-upscale106-ui2/
work/mods-enhanced107/
work/runs/
work/checkpoint009/
work/repro-dependency-check/
outputs/*.zip
outputs/*.sha256
outputs/*.png

# Translated game code is generated from your own copy of the game (see README).
work/project/source/profiles/renegade/generated/

